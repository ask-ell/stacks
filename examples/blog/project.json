{
  "name": "blog",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "examples/blog/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "dependsOn": ["^build"],
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/examples/blog",
        "main": "examples/blog/src/index.ts",
        "tsConfig": "examples/blog/tsconfig.lib.json",
        "assets": [
          "examples/blog/*.md"
        ]
      }
    },
    "nx-release-publish": {
      "executor": "nx:noop"
    }
  }
}
