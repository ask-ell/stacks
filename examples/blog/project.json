{
  "name": "blog",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "examples/blog/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "command": "webpack-cli build",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "development": {
          "args": ["--config-node-env=development"]
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": [
        "^build"
      ],
      "options": {
        "buildTarget": "blog:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "blog:build:development"
        }
      }
    },
    "nx-release-publish": {
      "executor": "nx:noop"
    }
  }
}
