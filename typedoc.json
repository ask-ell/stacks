{
  "$schema": "https://typedoc.org/schema.json",
  "tsconfig": "tsconfig.docs.json",
  "out": "docs",
  "name": "Stacks",
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "skipErrorChecking": true,
  "readme": "website/index.md",
  "searchInComments": true,
  "searchInDocuments": true,
  "navigationLinks": {
    "Example": "https://github.com/ask-ell/stacks/tree/develop/examples/blog",
    "GitHub": "https://github.com/ask-ell/stacks",
    "Contribute": "https://opencollective.com/ask-ell/projects/ask-ell-stacks"
  },
  "entryPoints": [
    "packages/core/src/index.ts",
    "packages/ddd/src/index.ts",
    "packages/hexa/src/index.ts",
    "packages/keyv/src/index.ts",
    "packages/node/src/index.ts",
    "packages/k8s/src/index.ts",
    "packages/github/src/index.ts",
    "packages/gitlab/src/index.ts",
    "packages/sentry/src/index.ts",
    "packages/nest/src/index.ts",
    "packages/react/src/index.ts",
    "packages/back-end/src/index.ts"
  ]
}
